# Backend environment. Copy to backend/.env and fill in.

# Supabase — when unset, the backend runs on an in-memory store so the
# demo works with no external dependencies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Language model. Set ONE of the two keys below.
#
# Anthropic handles every call, including reading the insurance card image
# and the Evidence of Coverage PDF.
ANTHROPIC_API_KEY=

# DeepSeek is an OpenAI-compatible, text-only API: it maps CPT codes and
# drafts appeal letters, but cannot read the card or the EOC, so those two
# parsers fall back to clearly-labelled sample data.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Force a provider when both keys are set. Empty picks whichever is
# configured, preferring anthropic. One of: anthropic, deepseek.
LLM_PROVIDER=

# ARIA
ARIA_VERSION=1.0

# Rule engine
ML_CLASSIFIER_THRESHOLD=0.75
APPEAL_CONFIDENCE_THRESHOLD=0.70

# CORS origin for the Next.js dashboard
FRONTEND_ORIGIN=http://localhost:3000
