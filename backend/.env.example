# Backend environment. Copy to backend/.env and fill in.

# Supabase — when unset, the backend runs on an in-memory store so the
# demo works with no external dependencies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic - used by Insure to parse insurance documents and map CPT codes.
# Unset, the parsers return clearly-labelled sample data instead.
ANTHROPIC_API_KEY=

# ARIA
ARIA_VERSION=1.0

# Rule engine
ML_CLASSIFIER_THRESHOLD=0.75
APPEAL_CONFIDENCE_THRESHOLD=0.70

# CORS origin for the Next.js dashboard
FRONTEND_ORIGIN=http://localhost:3000
